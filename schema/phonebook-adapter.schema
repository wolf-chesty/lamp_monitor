type:
  _doc: phonebook adapter type
  _mandatory: true
  _type: string
  _options: [ "wizard" ]
name:
  _doc: phonebook adapter name
  _mandatory: true
  _type: string
match:
  _doc: filter for wizard type phone
  _mandatory: $type == 'wizard'
  _type: string
symbol_maps:
  _doc: map of symbols to YAML keys
  _mandatory: false
  _type: symbol-map[]
